# Copy to .env and fill in. Never commit .env or any wallet file.
# chmod 600 .env

# Attribution code for the Celo competition (ERC-8021 builder code).
# loops.house assigned celo_e07a8049a2b1 at registration (26 Nov 2026);
# that is the active code. Without this line the repo-derived code
# celo_d03a2a1ad16b (sha256 of the repo slug, first 12 hex) is used.
ATTRIBUTION_CODE=celo_e07a8049a2b1

# Network: testnet (Celo Sepolia, default) | mainnet (Celo mainnet)
X402_NETWORK=testnet

# Facilitator API key (seller side only). Create at https://x402.celo.org:
# connect a wallet, sign (no gas), copy the key shown once.
X402_API_KEY=

# Address that receives the USDC the seller charges (seller side).
SELLER_PAY_TO=

# Bob's Celo wallet file (created for this project; NOT in this repo).
# Path to a JSON file { "address", "privateKey", "mnemonic" }.
BOB_WALLET_FILE=/home/hatch/workspace/celo/bob-celo-wallet.json

# URL of the x402-paid API the buyer pays for (default: local seller).
SELLER_URL=http://localhost:3000/premium

# Buyer spend cap per payment (default $0.05). The buyer refuses anything above it.
BUYER_MAX_PER_PAYMENT=$0.05

# Agent Vault (MCP) — from the Agent Vault dashboard, "Connect another agent".
# The MCP server URL is per-account; copy it from the dashboard, do not guess it.
# The agent signs in once in the browser (OAuth); tokens are stored by the MCP client.
AGENT_VAULT_MCP_URL=

# Regular website Bob signs into through Agent Vault (track requirement).
# The login must already be saved in the vault by the account owner.
VAULT_SIGNIN_URL=https://example.com/login
VAULT_LOGIN_TOKEN=
